<!DOCTYPE html>
<html lang="en">
  <body>
    <main>
      <h2>Create a new video</h2>

      <form action="/video-archive" method="POST">
        <input type="text" name="name" placeholder="name" required /><br />
        <input type="text" name="slug" placeholder="slug" required /><br />
        <input
          type="number"
          name="durationInMinutes"
          placeholder="duration in minutes"
          required
          min="0"
          step="1"
        /><br />
        <button>Save</button>
      </form>
    </main>
  </body>
</html>
